GOMOKU_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GOMOKU_FRONTEND_URL=http://localhost:5173/
GOMOKU_ALLOW_MISSING_ORIGIN=false

# Optional. Empty disables POST /admin/drain.
GOMOKU_ADMIN_TOKEN=

# Platform port is read from the process environment, not this .env file.
# PORT=8000

# Durations are seconds; all settings use the GOMOKU_ prefix.
GOMOKU_RECONNECT_SECONDS=60
GOMOKU_HEARTBEAT_TIMEOUT=60
GOMOKU_UNDO_SECONDS=30
GOMOKU_UNDO_COOLDOWN=30
GOMOKU_WAITING_SECONDS=600
GOMOKU_IDLE_SECONDS=900
GOMOKU_FINISHED_SECONDS=600
GOMOKU_EMPTY_SECONDS=300
GOMOKU_MAX_ROOMS=50
GOMOKU_MAX_CONNECTIONS=200
GOMOKU_RECONNECT_RESERVE=20
GOMOKU_MAX_SPECTATORS=20
